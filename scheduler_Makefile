CC = gcc
CFLAGS = -Wall -Wextra -std=c11 -O2 -D_GNU_SOURCE -D_POSIX_C_SOURCE=200809L

UNAME_S := $(shell uname -s)
ifeq ($(UNAME_S),Linux)
    LDFLAGS = -lm -lrt
else ifeq ($(UNAME_S),Darwin)
    LDFLAGS = -lm
else
    LDFLAGS = -lm
endif

TARGET = scheduler
SRCS = scheduler.c
OBJS = $(SRCS:.c=.o)

$(TARGET): $(OBJS)
	$(CC) $(CFLAGS) -o $(TARGET) $(OBJS) $(LDFLAGS)

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -f $(OBJS) $(TARGET)

test:
	@echo "Testing scheduler..."
	@echo "Usage: ./scheduler --program <exe> --interval <time> --repeat <count>"

help:
	@echo "Targets:"
	@echo "  make              - Build scheduler executable"
	@echo "  make clean        - Remove build artifacts"
	@echo "  make test         - Run tests"
	@echo "  make help         - Show this help"

.PHONY: clean test help
